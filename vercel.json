{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * 2"
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/boot.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/team/:id",
      "destination": "/app"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.dkbbdb.com"
        }
      ],
      "destination": "https://dkbbdb.com/$1",
      "permanent": true
    },
    {
      "source": "/u/:name",
      "destination": "/?u=:name",
      "permanent": false
    }
  ]
}
